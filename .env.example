# Copy to .env and fill in. All keys are OPTIONAL.
# Without an OpenAI key the app runs in deterministic offline (rule-based) mode.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBED_MODEL=text-embedding-3-small

# Vendor screening tool (Historical Intelligence Agent).
# Defaults to files/worldbank_debarred_SAMPLE.csv; point at a fuller export to scale.
# VENDOR_DEBARMENT_CSV=files/worldbank_debarred_SAMPLE.csv

# OKF memory for the Contract Risk Agent
OKF_MEMORY_ROOT=backend/agent_profiles/contract_agent_profile
OKF_WRITE_MEMORY_INDEX=1
OKF_INDEX_PGVECTOR=0
OKF_USE_PGVECTOR_RETRIEVAL=0

# Postgres (used by docker-compose; app runs without it too)
DATABASE_URL=postgresql://premortem:premortem@localhost:5432/premortem

# Frontend -> backend URL
PREMORTEM_API=http://localhost:8000
